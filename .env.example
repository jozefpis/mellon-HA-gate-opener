# ==== Mellon — configuration ====
# Copy to .env (local) or set these as App Config → Environment Variables in CapRover.

# Admin password (single admin). CHANGE THIS!
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Home Assistant webhook that opens the gate (set your real URL)
HA_WEBHOOK_URL=https://your-home-assistant/api/webhook/your-webhook-id
HA_WEBHOOK_METHOD=POST

# Optional query string appended to the webhook URL (verbatim, no leading '?').
# Use it if the HA automation verifies a query parameter, e.g. with the template
# {{ 'dev123' in trigger.query }} — then set HA_WEBHOOK_QUERY=dev123.
# Leave empty if HA does not verify any query parameter.
HA_WEBHOOK_QUERY=

# Default UI language. One of: en, es, de, sk, cs, pl, zh, ja, hu
# (users can still switch language in the app; this is only the default).
DEFAULT_LOCALE=en

# Preview / dry-run mode. When true:
#   - real /g/<token> links work normally (button, animation, usage counter) but
#     the webhook is NEVER called, so the gate does NOT physically open;
#   - the app also exposes /preview, a client-side simulation of every visual.
# Lets you test/demo real links and eyeball the animations — even on a live
# deployment — without opening the gate. Leave off in normal operation.
# Accepts: true/1/yes/on.
PREVIEW_MODE=

# Where the SQLite database is stored (in CapRover set to /app/data/mellon.db)
# DB_PATH=./data/mellon.db

# Server port
PORT=3000
