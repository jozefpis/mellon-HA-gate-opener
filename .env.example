# ==== Mellon — configuration ====
# Copy to .env (local) or set these as App Config → Environment Variables in CapRover.

# Admin password (single admin). CHANGE THIS!
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Home Assistant webhook that opens the gate (set your real URL)
HA_WEBHOOK_URL=https://your-home-assistant/api/webhook/your-webhook-id
HA_WEBHOOK_METHOD=POST

# Default UI language. One of: en, es, de, sk, cs, pl, zh, ja, hu
# (users can still switch language in the app; this is only the default).
DEFAULT_LOCALE=en

# Where the SQLite database is stored (in CapRover set to /app/data/mellon.db)
# DB_PATH=./data/mellon.db

# Server port
PORT=3000
